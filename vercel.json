{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://pagead2.googlesyndication.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com; frame-src 'self' https://googleads.g.doubleclick.net; object-src 'none'; frame-ancestors 'self' upgrade-insecure-requests;"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/(.*).(css|js|jpg|jpeg|png|svg|webp|ico|woff2|json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "www.apicalculators.com"}],
      "destination": "https://apicalculators.com/:path*",
      "permanent": true
    },
    {
      "source": "/vector-db-cost.html",
      "destination": "/vector-database-cost.html",
      "permanent": true
    },
    {
      "source": "/ai-image-cost-calculator.html",
      "destination": "/image-generation-cost.html",
      "permanent": true
    },
    {
      "source": "/stripe-vs-paddle-calculator.html",
      "destination": "/payment-processor-fees.html",
      "permanent": true
    },
    {
      "source": "/aws-lambda-calculator.html",
      "destination": "/serverless-cost-calculator.html",
      "permanent": true
    },
    {
      "source": "/api-gateway-cost.html",
      "destination": "/api-gateway-pricing.html",
      "permanent": true
    },
    {
      "source": "/ai-agent-cost-calculator.html",
      "destination": "/ai-agent-cost.html",
      "permanent": true
    },
    {
      "source": "/llm",
      "destination": "/llm-cost-calculator.html",
      "permanent": false
    },
    {
      "source": "/vector",
      "destination": "/vector-database-cost.html",
      "permanent": false
    },
    {
      "source": "/image",
      "destination": "/image-generation-cost.html",
      "permanent": false
    },
    {
      "source": "/payment",
      "destination": "/payment-processor-fees.html",
      "permanent": false
    },
    {
      "source": "/serverless",
      "destination": "/serverless-cost-calculator.html",
      "permanent": false
    },
    {
      "source": "/gateway",
      "destination": "/api-gateway-pricing.html",
      "permanent": false
    },
    {
      "source": "/embedding",
      "destination": "/embedding-api-cost.html",
      "permanent": false
    },
    {
      "source": "/agent",
      "destination": "/ai-agent-cost.html",
      "permanent": false
    },
    {
      "source": "/coding",
      "destination": "/ai-coding-tool-cost.html",
      "permanent": false
    },
    {
      "source": "/auth",
      "destination": "/auth-provider-cost.html",
      "permanent": false
    },
    {
      "source": "/cloud",
      "destination": "/cloud-vps-comparison.html",
      "permanent": false
    },
    {
      "source": "/stt",
      "destination": "/stt-tts-api-cost.html",
      "permanent": false
    }
  ]
}
